# PostgreSQL connection details. Render supplies these automatically in production.
DATABASE_URL=jdbc:postgresql://localhost:5432/beauty_mart
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-with-your-local-database-password

# Google Identity Services web client ID.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# At least 32 random bytes. Example generation: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret

# Frontend origin allowed to call this API.
FRONTEND_URL=http://localhost:3000

# Optional. Defaults are shown below.
DATABASE_POOL_SIZE=5
PORT=8080
JWT_EXPIRATION=PT12H

# Mailgun transactional email. A sandbox domain can only send to authorized recipients.
MAILGUN_API_KEY=replace-with-your-domain-sending-key
MAILGUN_DOMAIN=sandbox-example.mailgun.org
MAILGUN_FROM=Beauty Mart <postmaster@sandbox-example.mailgun.org>
MAILGUN_ADMIN_EMAIL=owner@example.com
MAILGUN_BASE_URL=https://api.mailgun.net
